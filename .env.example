# RigMind Backend Server Configuration
PORT=3001
NODE_ENV=development

# IGDB API (Twitch Developer Console)
# Obtain from https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret

# Steam Web API
# Obtain from https://steamcommunity.com/dev/apikey
# Note: Steam Store Search & App Details endpoints work publicly without an API key!
STEAM_API_KEY=your_steam_api_key

# Database Configuration (Optional external database URL, defaults to local JSON store in server/data/games.json)
DATABASE_URL=
